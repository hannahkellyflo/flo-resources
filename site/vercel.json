{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "destination": "/tracker",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/app/tracker/:path*",
      "destination": "/app/tracker/index.html"
    },
    {
      "source": "/tracker/:path*",
      "destination": "/tracker/index.html"
    }
  ]
}
